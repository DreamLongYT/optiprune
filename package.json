{
  "name": "optiprune",
  "version": "2.1.6",
  "description": "Resilient static dead-code analyzer for TypeScript and JavaScript workspaces.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://opti.drml.int.yt/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DreamLongYT/optiprune.git"
  },
  "bugs": {
    "url": "https://github.com/DreamLongYT/optiprune/issues"
  },
  "keywords": [
    "analysis",
    "analyze",
    "class",
    "cli",
    "dead code",
    "dependencies",
    "detect",
    "devDependencies",
    "duplicate",
    "entropy",
    "enum",
    "export",
    "files",
    "find",
    "javascript",
    "lint",
    "maintenance",
    "members",
    "missing",
    "monorepo",
    "namespace",
    "package",
    "scan",
    "types",
    "typescript",
    "unreferenced",
    "unresolved",
    "unused",
    "workspace",
    "optiprune",
    "pruning",
    "dead",
    "opti",
    "optimization"
  ],
  "bin": {
    "optiprune": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npx tsc -p tsconfig.json",
    "check": "npx tsc -p tsconfig.json --noEmit",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest",
    "analyze": "node ./dist/cli.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "npm run build",
    "release": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && npm ci && npm run build"
  },
  "dependencies": {
    "@optiprune/core": "1.0.2",
    "commander": "^15.0.0",
    "pathe": "2.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "license": "MIT",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "author": "DreamLongYT"
}
