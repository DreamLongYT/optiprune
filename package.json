{
  "name": "optiprune",
  "version": "1.8.15",
  "description": "Resilient static dead-code analyzer for TypeScript and JavaScript workspaces.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://opti.drml.int.yt/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DreamLongYT/optiprune.git"
  },
  "bugs": {
    "url": "https://github.com/DreamLongYT/optiprune/issues"
  },
  "keywords": [
    "analysis",
    "analyze",
    "class",
    "cli",
    "dead code",
    "dependencies",
    "detect",
    "devDependencies",
    "duplicate",
    "entropy",
    "enum",
    "export",
    "files",
    "find",
    "javascript",
    "lint",
    "maintenance",
    "members",
    "missing",
    "monorepo",
    "namespace",
    "package",
    "scan",
    "types",
    "typescript",
    "unreferenced",
    "unresolved",
    "unused",
    "workspace",
    "optiprune",
    "pruning",
    "dead",
    "opti",
    "optimization"
  ],
  "bin": {
    "optiprune": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npx tsc -p tsconfig.json",
    "check": "npx tsc -p tsconfig.json --noEmit",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest",
    "analyze": "node ./dist/cli.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "npm run build",
    "release": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && npm ci && npm run build"
  },
  "dependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/helper-plugin-utils": "^8.0.1",
    "@babel/parser": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@babel/plugin-transform-typescript": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/traverse": "^8.0.4",
    "@babel/types": "^8.0.4",
    "@swc/core": "^1.15.47",
    "commander": "^15.0.0",
    "esbuild": "^0.28.1",
    "fast-glob": "^3.3.3",
    "js-yaml": "^5.2.2",
    "pathe": "2.0.3",
    "quickjs-emscripten": "^0.32.0",
    "z3-solver": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4",
    "vue": "^3.5.40"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "license": "MIT",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "author": "DreamLongYT"
}
